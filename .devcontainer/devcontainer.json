{
  "name": "hypercube (headless)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "containerUser": "dev",
  "mounts": [
    "source=hypercube-cargo-registry,target=/home/dev/.cargo/registry,type=volume",
    "source=hypercube-cargo-git,target=/home/dev/.cargo/git,type=volume",
    "source=hypercube-target-${localWorkspaceFolderBasename},target=/workspace/target,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "serayuzgur.crates",
        "polymeilex.wgsl",
        "mk12.better-git-line-blame"
      ]
    }
  }
}
