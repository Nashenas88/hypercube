{
  "name": "hypercube (AMD GPU + display)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "target": "gpu"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "containerUser": "dev",
  "runArgs": ["--device=/dev/dri", "--userns=keep-id:uid=1000,gid=1000"],
  "mounts": [
    "source=hypercube-cargo-cache,target=/usr/local/cargo,type=volume",
    "source=hypercube-target-${localWorkspaceFolderBasename},target=/workspace/target,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR},type=bind"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "serayuzgur.crates",
        "polymeilex.wgsl",
        "mk12.better-git-line-blame"
      ]
    }
  }
}
